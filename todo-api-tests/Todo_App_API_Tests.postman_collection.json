      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 400 Bad Request\", function () {",
              "    pm.response.to.have.status(400);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"description\": \"This todo is invalid because title is missing\",\n  \"priority\": \"LOW\",\n  \"dueDate\": \"2026-07-20\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/todos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "todos"
          ]
        }
      },
      "response": []
    },
    {
      "name": "4. Get Todo by ID (Valid)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Todo details match the created object\", function () {",
              "    var jsonData = pm.response.json();",
              "    var expectedId = pm.collectionVariables.get(\"createdTodoId\");",
              "    pm.expect(jsonData.id).to.eql(expectedId);",
              "    pm.expect(jsonData.title).to.eql(\"Learn Docker and CI/CD\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/todos/{{createdTodoId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "todos",
            "{{createdTodoId}}"
          ]
        }
      },
      "response": []
    },
