          "mode": "raw",
          "raw": "{\n  \"title\": \"Learn Docker, CI/CD, and Kubernetes\",\n  \"description\": \"Expanded goal to cover orchestration\",\n  \"priority\": \"HIGH\",\n  \"dueDate\": \"2026-07-25\"\n}"
        },
        "url": {
