{
  "info": {
    "_postman_id": "7a35368a-b9c6-48c0-bc6f-5b62b1a136b8",
    "name": "Todo App API Tests",
    "description": "Integration tests for the Todo Application REST API endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Get All Todos (Initial)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response is an array\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.be.an('array');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/todos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "todos"
          ]
        }
      },
      "response": []
    },
    {
      "name": "2. Create Todo (Valid)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test(\"Todo is created successfully with matching properties\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.id).to.exist;",
              "    pm.expect(jsonData.title).to.eql(\"Learn Docker and CI/CD\");",
              "    pm.expect(jsonData.description).to.eql(\"Finish setting up Jenkins pipeline and Docker containers\");",
              "    pm.expect(jsonData.priority).to.eql(\"HIGH\");",
              "    pm.expect(jsonData.completed).to.be.false;",
              "    ",
              "    // Save the created ID for subsequent requests",
              "    pm.collectionVariables.set(\"createdTodoId\", jsonData.id);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Learn Docker and CI/CD\",\n  \"description\": \"Finish setting up Jenkins pipeline and Docker containers\",\n  \"priority\": \"HIGH\",\n  \"dueDate\": \"2026-07-20\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/todos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "todos"
          ]
        }
      },
      "response": []
    },
    {
